SECRET_KEY=replace-with-your-strong-secret-key-in-production
DEBUG=True

# ALLOWED_HOSTS: Danh sách hostname/IP cho phép truy cập, phân cách bằng dấu phẩy (không kèm scheme http:// hoặc port)
# Ví dụ khi truy cập từ mạng LAN: localhost,127.0.0.1,192.168.1.100
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# CSRF_TRUSTED_ORIGINS: Bắt buộc kèm scheme (http:// hoặc https://) và port nếu khác 80/443 để bảo vệ form POST khi truy cập qua LAN trong Django 4.0+
# Ví dụ: http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.100:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.100:8000

MAX_UPLOAD_SIZE_MB=50
MAX_PREVIEW_SIZE_MB=10
