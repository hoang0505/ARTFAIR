# ==============================================================================
# ARTFAIR - Production Environment Configuration for PythonAnywhere
# Sao chép nội dung này thành file .env thật tại:
# /home/<your-username>/ARTFAIR/artfair_backend/.env
# ==============================================================================

# 1. SECRET_KEY: Tạo chuỗi ngẫu nhiên bảo mật trên Bash console:
# python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-this-to-a-unique-and-secret-random-key-in-production

# 2. DEBUG: Luôn là False ở môi trường production công khai
DEBUG=False

# 3. ALLOWED_HOSTS: Tên miền cụ thể của bạn (thay thế <your-username>)
ALLOWED_HOSTS=<your-username>.pythonanywhere.com,localhost,127.0.0.1

# 4. CSRF_TRUSTED_ORIGINS: Bắt buộc scheme https:// trên PythonAnywhere
CSRF_TRUSTED_ORIGINS=https://<your-username>.pythonanywhere.com

# 5. SECURE_COOKIES: Bật cookie bảo mật qua kết nối HTTPS
SECURE_COOKIES=True

# 6. Giới hạn dung lượng tải lên (MB)
MAX_UPLOAD_SIZE_MB=50
MAX_PREVIEW_SIZE_MB=10
